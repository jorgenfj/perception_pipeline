# clangd reads the nvcc command lines out of compile_commands.json, but it is
# clang -- it chokes on nvcc-only flags and has to be told where CUDA lives.

# `.clangd` adapts the nvcc command lines for clang: it strips nvcc-only flags
# such as `-gencode`, and pins an indexing architecture. The container installs
# clangd 19 from [apt.llvm.org](https://apt.llvm.org) -- jammy's own clangd 14
# predates `sm_87`, cannot parse libstdc++ 13's `<chrono>` (C++20 consteval), and
# trips over CUDA 12's headers. These flags affect indexing only and never reach
# the real build.
CompileFlags:
  Remove:
    - -gencode*
    - --generate-code*
    - -forward-unknown-to-host-compiler
    - --expt-*
    - --extended-lambda
    - -Xcompiler*
    - -Xcudafe*
    - --options-file
  Add:
    - --cuda-path=/usr/local/cuda
    # Indexing-only architecture -- it does not affect what nvcc actually builds.
    - --cuda-gpu-arch=sm_87
    # clang 19 knows CUDA up to 12.6 and refuses the toolkit's 12.8 without this.
    - --no-cuda-version-check
    - -I/usr/local/cuda/include
  CompilationDatabase: build

Diagnostics:
  UnusedIncludes: Strict
  # IncludeCleaner walks Eigen's internal headers and asks for
  # <eigen3/Eigen/src/Core/...> directly. <eigen3/Eigen/Dense> is the
  # supported entry point, so the suggestions are all noise.
  MissingIncludes: None

Completion:
  # Never insert an #include as a side effect of accepting a completion.
  HeaderInsertion: Never
